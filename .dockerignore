# 构建上下文要小，也别把个人数据带进镜像
.git
.gitignore
.pylibs
.pylibs-dml
.tmp
models
tests
eval
docs
scripts

# 评测输出不进镜像，只带「今日复习」的题库（40 KB）。
# 下面这条 ! 必须排在 results/** 之后，Docker 按顺序匹配。
results/**
!results/run_hybrid.json

# 语料原文：几百 MB，容器里用不到（只服务检索和问答）
data/raw

# 个人简历索引：不能公开
data/index/profile

# 各种本地产物
*.pyc
__pycache__
*.log
.env
.env.*
