# 魔搭创空间（ModelScope Studio）用的镜像。
#
# 和仓库根目录的 Dockerfile 只有一处不同：模型从 modelscope.cn 下，不走
# hf-mirror。创空间的构建机在阿里云，直连魔搭比走海外镜像站更快也更稳；
# 反过来 HF Spaces 的构建机走官方域名最快，所以两边各留一份。
#
# 改这里记得同步 Dockerfile（除了模型源那两行，其余应当完全一致）。
#
#   docker build -f Dockerfile.modelscope -t kb:latest .
#   docker run --rm -p 7860:7860 kb:latest
#
# 目录约定（构建时必须存在）：
#   src/  tools/  ingest.py  config.toml  requirements-deploy.txt
#   data/index/   检索索引（tech，约 139 MB，走 git lfs）
#   docker.yaml   创空间的构建配置，指向本文件

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/app/.hf-cache \
    PORT=7860

WORKDIR /app

# 依赖单独一层：只改代码时不会重装
COPY requirements-deploy.txt ./
RUN pip install --no-cache-dir -r requirements-deploy.txt

COPY tools ./tools

# 模型在构建期下好，别让第一个访客等 2.1 GB 下载。
# 魔搭的 BAAI/bge-m3 同步了 onnx/model.onnx + onnx/model.onnx_data，
# 下下来的目录结构和 HF 那份一样，config.toml 的 model_dir 不用改。
# 这一层特意放在 COPY src 之前：改代码不会让它失效，省一次 2.1 GB 下载。
RUN KB_MODEL_SOURCE=modelscope python tools/fetch_model.py models BAAI/bge-m3

# 代码放在模型之后：只改 src 时上面那层直接命中缓存。
COPY src ./src
COPY ingest.py config.toml ./

# 索引跟着镜像走。139 MB，走 git lfs 推到创空间仓库。
COPY data/index ./data/index

# 平台构建时偶尔不 smudge LFS，上下文里的索引就只剩 `version https://git-lfs...`
# 的指针文件，容器起来在「加载索引」阶段抛 Expecting value: line 1 column 1。
# 自检不过就从仓库的文件接口重拉 —— 那个接口返回的是 LFS 解析后的真内容。
# 换空间名（或换账号）时改下面 --repo 的值。
RUN python tools/check_index.py data/index || \
    python tools/fetch_index.py data/index --repo HY666YS/kb-qa

# 「今日复习」的题库（40 KB）。不 COPY 的话线上那个入口只会显示「题库读不出来」。
COPY results ./results

# 不建 data/raw：语料原文没随镜像走，前端按 /api/health 的 raw_dir_exists=false
# 隐藏「在 VS Code 打开」和「源文件未找到」。建一个空目录反而会让健康检查报
# true，前端就以为本地有语料，每条结果下面挂一行红字。

EXPOSE 7860

# --no-browser 必须带：容器里没有图形界面，webbrowser.open 只会报错
CMD ["sh", "-c", "python ingest.py web --no-browser --host 0.0.0.0 --port ${PORT:-7860}"]
